From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: hmos2sweet <hmos2sweet@localhost>
Date: Tue, 20 Oct 2026 07:04:10 +0200
Subject: [PATCH 13/13] venus: do not reboot the phone when a coprocessor
 restart fails

CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT panics after 20 s when a subsystem
notifier blocks during a restart of the ADSP or the modem. On a port where
userspace (sensors, WLAN, audio) is still being brought up these restarts
happen and the panic reboots the phone. Turn it into a warning, and with
hmos.noreboot=1 also log a crash during SSR instead of panicking.

Forward-ported from hmos2sweet 0013 (4.14) to sm8350 5.4 for venus.
---
 arch/arm64/configs/vendor/ohos.config    |  5 ++++-
 drivers/soc/qcom/msm_subsystem_restart.c | 10 ++++++++++
 kernel/reboot.c                          |  1 +
 3 files changed, 15 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/configs/vendor/ohos.config b/arch/arm64/configs/vendor/ohos.config
index d7d44d4a7..f384ba59d 100644
--- a/arch/arm64/configs/vendor/ohos.config
+++ b/arch/arm64/configs/vendor/ohos.config
@@ -1,4 +1,4 @@
-# HarmonyOS / OpenHarmony userspace on sweet (stage 1 bring-up)
+# HarmonyOS / OpenHarmony userspace on venus (stage 1 bring-up)
 CONFIG_ACCESS_TOKENID=y
 CONFIG_BINDER_SENDER_INFO=y
 # CONFIG_OHOS_DM_PARTNAME is not set  (init matches dm-N by device name instead)
@@ -29,3 +29,6 @@ CONFIG_OHOS_FS_EMU=y
 CONFIG_TMPFS=y
 # installd code signing on a kernel without fs-verity
 CONFIG_OHOS_FSVERITY_STUB=y
+# a coprocessor (ADSP/modem) that is slow to restart must not take the whole
+# phone down: subsystem notifier timeouts only warn
+# CONFIG_PANIC_ON_SSR_NOTIF_TIMEOUT is not set
diff --git a/drivers/soc/qcom/msm_subsystem_restart.c b/drivers/soc/qcom/msm_subsystem_restart.c
index 707a882b9..81b7e8252 100644
--- a/drivers/soc/qcom/msm_subsystem_restart.c
+++ b/drivers/soc/qcom/msm_subsystem_restart.c
@@ -1046,6 +1046,16 @@ static void __subsystem_restart_dev(struct subsys_device *dev)
 			__pm_stay_awake(dev->ssr_wlock);
 			queue_work(ssr_wq, &dev->work);
 		} else {
+#ifdef CONFIG_OHOS_BRINGUP_NOREBOOT
+			extern bool hmos_noreboot;
+
+			if (hmos_noreboot) {
+				pr_err("subsys-restart: %s crashed during SSR (hmos.noreboot: not panicking)\n",
+					name);
+				spin_unlock_irqrestore(&track->s_lock, flags);
+				return;
+			}
+#endif
 			panic("Subsystem %s crashed during SSR!", name);
 		}
 	} else
diff --git a/kernel/reboot.c b/kernel/reboot.c
index 0a913046a..9483a2261 100644
--- a/kernel/reboot.c
+++ b/kernel/reboot.c
@@ -318,6 +318,7 @@ DEFINE_MUTEX(system_transition_mutex);
  * is refused and logged so the system stays up for debugging.
  */
 bool hmos_noreboot;
+EXPORT_SYMBOL_GPL(hmos_noreboot);
 static int __init hmos_noreboot_setup(char *str)
 {
 	hmos_noreboot = (str && *str == '1');
